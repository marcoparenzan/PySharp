<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PySharpLib\PySharpLib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata: the sqlite3 stdlib module, split out of PySharpLib so the core
         embeddable interpreter doesn't force every consumer to carry Microsoft.Data.Sqlite. -->
    <PackageId>PySharp.Sqlite3</PackageId>
    <Version>2.3.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>PySharp's sqlite3 module — a real DB-API 2.0 shim over Microsoft.Data.Sqlite. Opt-in companion to PySharp.Interpreter.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>python;sqlite;sqlite3;dbapi;pysharp</PackageTags>
    <PackageProjectUrl>https://github.com/marcoparenzan/PySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcoparenzan/PySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite 10.0.10 pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which has a known
         high-severity advisory (GHSA-2m69-gcr7-jv3q); pin the transitive dependency to a patched
         version explicitly. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
