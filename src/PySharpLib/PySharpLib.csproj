<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata: the interpreter as a standalone, embeddable library. -->
    <PackageId>PySharp.Interpreter</PackageId>
    <Version>1.6.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>PySharp — a Python 3.x interpreter written from scratch in C# (.NET 10), embeddable as a library via the PyEngine facade. No CPython dependency.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>python;interpreter;scripting;embedding;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Microsoft.Data.Sqlite 10.0.10 pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which has a known
         high-severity advisory (GHSA-2m69-gcr7-jv3q); pin the transitive dependency to a patched
         version explicitly. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
