<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>PySharp.JupyterSharp.Kernel</PackageId>
    <Version>0.1.1-net11-preview.5</Version>
    <Authors>Marco Parenzan</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A JupyterSharp kernel plugin that runs Python cells on this repo's own PyEngine, with session state shared across cells.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin contract, resolved from D:\Dev\NuGetLocalFeed (already a source in the
         machine's NuGet.Config) — JupyterSharp.Host loads this project's published output as a
         plugin, matching its own copy of this package by identity so `is IKernelPlugin` works;
         see JupyterSharp's KernelPluginLoader for why. -->
    <PackageReference Include="JupyterSharp.Kernels.Abstractions" Version="0.3.1-net11-preview.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PySharpLib\PySharpLib.csproj" />
    <ProjectReference Include="..\PySharpLib.Numpy\PySharpLib.Numpy.csproj" />
    <ProjectReference Include="..\PySharpLib.Cv2\PySharpLib.Cv2.csproj" />
    <ProjectReference Include="..\PySharpLib.Pywt\PySharpLib.Pywt.csproj" />
    <ProjectReference Include="..\PySharpLib.Pandas\PySharpLib.Pandas.csproj" />
    <ProjectReference Include="..\PySharpLib.Matplotlib\PySharpLib.Matplotlib.csproj" />
    <ProjectReference Include="..\PySharpLib.Torch\PySharpLib.Torch.csproj" />
  </ItemGroup>
  <!-- Opt-in (the VS Code extension packaging sets PySharpExternalNatives=true): leave the big native libraries out of the output.
       libtorch (torch_cpu) is found by TorchSharp in the NuGet cache; OpenCV by NativeSupport. ScienceSharp\Install-Natives.ps1 restores both.
       The default keeps everything bundled, which is what the ecosystem gate builds. -->
  <PropertyGroup>
    <PySharpExternalNatives Condition="'$(PySharpExternalNatives)' == ''">false</PySharpExternalNatives>
  </PropertyGroup>
  <Target Name="StripExternalNatives" AfterTargets="Publish" Condition="'$(PySharpExternalNatives)' == 'true'">
    <!-- With a runtime id the natives are published into the root, without one into runtimes/<rid>/native: the globs cover both. -->
    <ItemGroup>
      <_ExternalNative Include="$(PublishDir)**/torch_cpu.*" />
      <_ExternalNative Include="$(PublishDir)**/libtorch_cpu.*" />
      <_ExternalNative Include="$(PublishDir)**/libtorch_python.*" />
      <_ExternalNative Include="$(PublishDir)**/OpenCvSharpExtern*" />
      <_ExternalNative Include="$(PublishDir)**/opencv_videoio_ffmpeg*" />
    </ItemGroup>
    <Message Importance="high" Text="PySharpExternalNatives: leaving out %(_ExternalNative.Filename)%(_ExternalNative.Extension)" Condition="'@(_ExternalNative)' != ''" />
    <Delete Files="@(_ExternalNative)" />
  </Target>
</Project>