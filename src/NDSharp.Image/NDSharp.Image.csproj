<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8981</NoWarn>

    <!-- NuGet package metadata: cv2-shaped image operations on NDSharp arrays (OpenCV via OpenCvSharp). -->
    <PackageId>NDSharp.Image</PackageId>
    <Version>2.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>NDSharp.Image — OpenCV-style image processing (imread, cvtColor, filters, morphology, warps, features) on NDSharp arrays, backed by OpenCvSharp. No Python dependency.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>opencv;image;ndarray;ndsharp;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/marcoparenzan/PySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcoparenzan/PySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NDSharp\NDSharp.csproj" />
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
  </ItemGroup>

</Project>
