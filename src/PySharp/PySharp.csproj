<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PySharpLib\PySharpLib.csproj" />
    <ProjectReference Include="..\PySharpLib.Numpy\PySharpLib.Numpy.csproj" />
    <ProjectReference Include="..\PipSharpLib\PipSharpLib.csproj" />
    <ProjectReference Include="..\PySharpLib.Sqlite3\PySharpLib.Sqlite3.csproj" />
    <ProjectReference Include="..\PySharpLib.Pyodbc\PySharpLib.Pyodbc.csproj" />
    <ProjectReference Include="..\PySharpLib.Psycopg2\PySharpLib.Psycopg2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Impacchetta l'host come .NET global tool: `pysharp` invocabile ovunque (in PATH). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pysharp</ToolCommandName>
    <PackageId>PySharp</PackageId>
    <Version>2.0.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>PySharp — interprete Python 3.x scritto in C#, come strumento da riga di comando.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>python;interpreter;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/marcoparenzan/PySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcoparenzan/PySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
