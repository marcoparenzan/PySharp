<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PySharpLib\PySharpLib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata: the pyodbc stdlib module, split out of PySharpLib so the core
         embeddable interpreter doesn't force every consumer to carry Microsoft.Data.SqlClient. -->
    <PackageId>PySharp.Pyodbc</PackageId>
    <Version>2.2.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>PySharp's pyodbc module — a real DB-API 2.0 shim over Microsoft.Data.SqlClient (SQL Server). Opt-in companion to PySharp.Interpreter.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>python;pyodbc;sqlserver;dbapi;pysharp</PackageTags>
    <PackageProjectUrl>https://github.com/marcoparenzan/PySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcoparenzan/PySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
