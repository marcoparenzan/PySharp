<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PySharpLib\PySharpLib.csproj" />
    <ProjectReference Include="..\PySharpLib.Numpy\PySharpLib.Numpy.csproj" />
    <ProjectReference Include="..\NDSharp.Frame\NDSharp.Frame.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata: the pandas module, a Python binding over NDSharp.Frame. -->
    <PackageId>PySharp.Pandas</PackageId>
    <Version>2.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>PySharp's pandas module (Series, DataFrame, Index) — a Python binding over NDSharp.Frame. Opt-in companion to PySharp.Interpreter and PySharp.Numpy.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>python;pandas;dataframe;pysharp;ndsharp</PackageTags>
    <PackageProjectUrl>https://github.com/marcoparenzan/PySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcoparenzan/PySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
