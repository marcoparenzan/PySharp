<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PySharpLib\PySharpLib.csproj" />
    <ProjectReference Include="..\PySharpLib.Numpy\PySharpLib.Numpy.csproj" />
    <ProjectReference Include="..\NDSharp.Image\NDSharp.Image.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata: the cv2 module, a Python binding over NDSharp.Image (OpenCV via OpenCvSharp). -->
    <PackageId>PySharp.Cv2</PackageId>
    <Version>2.4.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>PySharp's cv2 module — a Python binding over NDSharp.Image (OpenCV through OpenCvSharp). Opt-in companion to PySharp.Interpreter and PySharp.Numpy.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>python;opencv;cv2;pysharp;ndsharp</PackageTags>
    <PackageProjectUrl>https://github.com/marcoparenzan/PySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcoparenzan/PySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
