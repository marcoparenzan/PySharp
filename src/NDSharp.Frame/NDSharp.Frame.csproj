<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet package metadata: pandas-style labelled tables (Series, DataFrame, Index) on typed columns. -->
    <PackageId>NDSharp.Frame</PackageId>
    <Version>2.4.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>NDSharp.Frame — pandas-style Series, DataFrame and Index (selection, alignment, missing data, groupby, merge, CSV, pandas-identical printing). No Python dependency.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dataframe;series;pandas;ndsharp;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/marcoparenzan/PySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marcoparenzan/PySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NDSharp\NDSharp.csproj" />
  </ItemGroup>

</Project>
