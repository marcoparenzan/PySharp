{
    // Runs the active Python file with PySharp (the `pysharp` global tool) instead of CPython.
    // Command: Terminal > Run Task > "PySharp: run current file"  (or assign a keyboard shortcut).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PySharp: run current file",
      "type": "shell",
      "command": "pysharp",
      "args": ["run", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
